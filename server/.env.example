# Server Configuration
NODE_ENV=production
PORT=3001

# CORS Configuration (comma-separated list of allowed origins)
# IMPORTANT: Only add domains that should access your API
# Development: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Production: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# AWS Cognito (if using)
AWS_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=your-user-pool-id
AWS_COGNITO_CLIENT_ID=your-client-id

# Database Configuration
DB_PATH=./database/db.json
DB_BACKUP_PATH=./database/backups

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=your-session-secret-change-this

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# AWS Services (Optional)
AWS_S3_BUCKET=your-backup-bucket
AWS_CLOUDWATCH_LOG_GROUP=/aws/dashboard/api
